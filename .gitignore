# 1. Python environment and cache
__pycache__/
*.py[cod]
venv/
.venv/
env/

# 2. Environment variable files (most likely to contain API keys/passwords)
.env
.env.*
!.env.example

# 3. Database and credentials
*.sqlite3
*.db
credentials.json
secrets.json

# 4. Key and certificate files
*.pem
*.key
*.p12


# Ignore environment files
.env
.env.*
